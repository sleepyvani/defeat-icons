{
  "name": "defeat-icons",
  "version": "1.0.2",
  "description": "18px fill-duo SVG icon components library for React, Vue, Svelte, and Solid",
  "type": "module",
  "main": "./dist/react/index.js",
  "module": "./dist/react/index.js",
  "types": "./dist/react/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js",
      "default": "./dist/react/*.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "default": "./dist/vue/index.js"
    },
    "./vue/*": {
      "types": "./dist/vue/*.d.ts",
      "import": "./dist/vue/*.js",
      "default": "./dist/vue/*.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./svelte/*": {
      "types": "./dist/svelte/*.d.ts",
      "import": "./dist/svelte/*.js",
      "default": "./dist/svelte/*.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js",
      "default": "./dist/solid/index.js"
    },
    "./solid/*": {
      "types": "./dist/solid/*.d.ts",
      "import": "./dist/solid/*.js",
      "default": "./dist/solid/*.js"
    },
    "./components/*": {
      "types": "./dist/types/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "react",
    "vue",
    "svelte",
    "solid",
    "svg",
    "icons",
    "duo-fill",
    "nucleo",
    "ui"
  ],
  "author": "vanixjnk",
  "homepage": "https://defeat-icons.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleepyvani/defeat-icons.git"
  },
  "bugs": {
    "url": "https://github.com/sleepyvani/defeat-icons/issues"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build",
    "generate:frameworks": "node scripts/generate-frameworks.mjs",
    "generate:web": "node scripts/generate-web-packages.mjs && node scripts/generate-font.mjs",
    "generate:all": "node scripts/generate-frameworks.mjs && node scripts/generate-web-packages.mjs && node scripts/generate-font.mjs",
    "publish:react": "npm publish ./packages/defeat-icons-react",
    "publish:vue": "npm publish ./packages/defeat-icons-vue",
    "publish:svelte": "npm publish ./packages/defeat-icons-svelte",
    "publish:solid": "npm publish ./packages/defeat-icons-solid",
    "publish:svg": "npm publish ./packages/defeat-icons-svg",
    "publish:preact": "npm publish ./packages/defeat-icons-preact",
    "publish:astro": "npm publish ./packages/defeat-icons-astro",
    "publish:elements": "npm publish ./packages/defeat-icons-elements",
    "publish:angular": "npm publish ./packages/defeat-icons-angular",
    "publish:font": "npm publish ./packages/defeat-icons-font",
    "publish:web": "npm publish ./packages/defeat-icons-svg && npm publish ./packages/defeat-icons-preact && npm publish ./packages/defeat-icons-astro && npm publish ./packages/defeat-icons-elements && npm publish ./packages/defeat-icons-angular && npm publish ./packages/defeat-icons-font",
    "publish:all": "npm publish ./packages/defeat-icons-react && npm publish ./packages/defeat-icons-vue && npm publish ./packages/defeat-icons-svelte && npm publish ./packages/defeat-icons-solid",
    "clean:demo": "rimraf dist-demo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "solid-js": ">=1.0.0",
    "svelte": ">=3.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "dependencies": {
    "defeat-icons-react": "^1.0.3",
    "motion": "^13.4.0",
    "tslib": "^2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^3.0.0",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^8.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
